# Скопируйте в /home/contest_robot/robot.env и закройте от чужих глаз:
#   sudo install -m 600 -o contest_robot -g contest_robot robot.env.example /home/contest_robot/robot.env
# Токен не храните в репозитории и не пересылайте в чатах.

FINAM_API_TOKEN=            # токен Finam Trade API (tapi_sk_...)
FINAM_ACCOUNT_ID=           # номер счёта: python -m finam_robot.check его покажет
FINAM_SYMBOL=CRZ6@RTSX
BOOK_SOURCE=rest            # rest — опрос стакана; grpc — поток (нужны классы из proto Finam)

# Бумажный режим по умолчанию: реальные данные и реальные ГО/эквити, но без заявок.
DRY_RUN=1
# Боевой режим: DRY_RUN=0 и ровно эта фраза. Без неё робот не запустится.
LIVE_TRADING_CONFIRM=

# Ограничения риска для первых боевых дней
MAX_LOTS=1
MARGIN_UTILIZATION=0.5
MAX_DAILY_LOSS_PCT=5

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
